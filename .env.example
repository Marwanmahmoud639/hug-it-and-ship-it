# Environment variables referenced by the code, grouped by what breaks without
# them. Copy to .env for local work; in Lovable/Netlify set them as project
# secrets instead. Never commit a filled-in .env — .gitignore excludes it.

# ─── Required: the app will not boot without these ───────────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project ref only (the subdomain of your Supabase URL). The AI-call TwiML
# endpoint builds the media-bridge wss:// URL from this.
SUPABASE_PROJECT_REF=
# Public origin of the deployed app, e.g. https://app.example.com. Twilio
# fetches TwiML from here, so it must be reachable from the internet.
PUBLIC_APP_ORIGIN=
APP_BASE_URL=
SITE_URL=
# base64 32-byte key for AES-256-GCM at-rest encryption of OAuth tokens and
# connector keys. Generate with: openssl rand -base64 32
APP_USER_CONNECTION_KEY_SECRET=

# ─── Discovery ───────────────────────────────────────────────────────────────
# At least one of FIRECRAWL_API_KEY or SERPER_API_KEY is required for
# decision-maker discovery to return anything. Direct SERP scraping is blocked
# by every major engine, so without one of these the DM step finds nothing.
FIRECRAWL_API_KEY=
SERPER_API_KEY=
GOOGLE_MAPS_KEY=
GOOGLE_MAPS_SERVER_KEY=
VITE_GOOGLE_MAPS_KEY=
# Optional paid enrichment fallbacks
APOLLO_API_KEY=
HUNTER_API_KEY=
TRESTLE_API_KEY=
APIFY_API_KEY=
APIFY_ACTOR_ID=
# Mailbox-level email verification; without it, pattern-guessed addresses ship
# MX-verified only and may bounce.
MILLIONVERIFIER_API_KEY=

# ─── Voice / SMS ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

# ─── AI ──────────────────────────────────────────────────────────────────────
# Powers the realtime voice bridge (speech-to-text, reasoning, and speech in a
# single connection). Required for autonomous AI calling.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
ANTHROPIC_API_KEY=

# ─── Social OAuth (optional) ─────────────────────────────────────────────────
# Register the apps first; redirect URL is
# <PUBLIC_APP_ORIGIN>/api/social/callback/<platform>
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ─── Email delivery ──────────────────────────────────────────────────────────
LOVABLE_API_KEY=
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_MAIL_APP_USER_CONNECTOR_CLIENT_API_KEY=

# ─── Billing / cron ──────────────────────────────────────────────────────────
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
# Shared secret guarding the /api/public/hooks/* scheduled endpoints.
CRON_SECRET=
